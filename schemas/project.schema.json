{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"anas-os/project.schema.json",
  "type":"object",
  "required":["id","name","type","stage","business","product","engineering","evidence"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,63}$"},
    "name":{"type":"string","minLength":1},
    "type":{"enum":["saas","marketplace","internal_tool","mobile_app","ai_application","ecommerce","school_management","healthcare","fintech","crm","content_platform","custom"]},
    "stage":{"enum":["discover","validate","define","build","verify","release","operate","measure","learn"]},
    "business":{"type":"object","required":["problem","targetCustomer","desiredOutcome"],"properties":{"problem":{"type":"string","minLength":10},"targetCustomer":{"type":"string","minLength":3},"desiredOutcome":{"type":"string","minLength":3},"marketHypothesis":{"type":"string"},"model":{"type":"string"}}},
    "product":{"type":"object","properties":{"valueProposition":{"type":"string"},"scope":{"type":"array","items":{"type":"string"}},"nonGoals":{"type":"array","items":{"type":"string"}},"acceptanceCriteria":{"type":"array","items":{"type":"string"}}}},
    "engineering":{"type":"object","properties":{"stack":{"type":"array","items":{"type":"string"}},"architecture":{"type":"string"},"dataModel":{"type":"string"},"securityModel":{"type":"string"},"integrations":{"type":"array","items":{"type":"string"}}}},
    "evidence":{"type":"object","required":["items"],"properties":{"items":{"type":"array","items":{"type":"object","required":["id","type","status"],"properties":{"id":{"type":"string"},"type":{"type":"string"},"status":{"enum":["unverified","recorded","verified","independently_verified"]},"source":{"type":"string"},"notes":{"type":"string"}}}}}},
    "risk":{"type":"array","items":{"$ref":"risk.schema.json"}},
    "metadata":{"type":"object"}
  }
}
