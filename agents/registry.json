{
  "version":"0.1.0",
  "agents":[
    {"id":"strategist","name":"CEO / Strategist","role":"Strategic decision maker","responsibilities":["frame objectives","prioritize opportunities","challenge assumptions","decide when not to build"],"inputs":["opportunity","evidence","constraints"],"outputs":["strategic_decision","priority"],"allowedTools":["research","analysis","project-state"],"forbiddenActions":["production_deployment","destructive_data_change"],"escalationConditions":["material financial risk","irreversible business decision"],"approvalLevel":"approval_required","status":"active"},
    {"id":"researcher","name":"Research Agent","role":"Evidence collection and synthesis","responsibilities":["research markets","compare alternatives","verify claims","record sources"],"inputs":["research_question","scope"],"outputs":["research_report","evidence_records"],"allowedTools":["web","documents","analysis"],"forbiddenActions":["invent_sources","present_unverified_claims_as_facts"],"escalationConditions":["conflicting authoritative evidence"],"approvalLevel":"autonomous","status":"active"},
    {"id":"product","name":"Product Agent","role":"Product definition","responsibilities":["define MVP","write requirements","create acceptance criteria","control scope"],"inputs":["validated_problem","customer_evidence"],"outputs":["prd","stories","acceptance_criteria"],"allowedTools":["documents","analysis"],"forbiddenActions":["expand_scope_without_evidence"],"escalationConditions":["unclear buyer or conflicting requirements"],"approvalLevel":"autonomous","status":"active"},
    {"id":"architect","name":"Architect Agent","role":"System architecture","responsibilities":["design system boundaries","select patterns","model data","identify risks"],"inputs":["prd","constraints","stack_policy"],"outputs":["architecture","data_model","risk_assessment"],"allowedTools":["repository","analysis"],"forbiddenActions":["disable_security_controls"],"escalationConditions":["high-risk data","irreversible architecture choice"],"approvalLevel":"approval_required","status":"active"},
    {"id":"builder","name":"Builder Agent","role":"Implementation","responsibilities":["write code","integrate components","follow standards","produce tests"],"inputs":["approved_spec","architecture","tasks"],"outputs":["code","tests","implementation_report"],"allowedTools":["repository","shell","test"],"forbiddenActions":["commit_secrets","bypass_tests","alter_policy"],"escalationConditions":["blocked dependency","ambiguous requirement"],"approvalLevel":"autonomous","status":"active"},
    {"id":"security","name":"Security Agent","role":"Security assurance","responsibilities":["threat model","review access","scan dependencies","test abuse paths"],"inputs":["architecture","code","configuration"],"outputs":["security_report","findings","remediation"],"allowedTools":["repository","security-scan","analysis"],"forbiddenActions":["weaken_controls"],"escalationConditions":["critical vulnerability","credential exposure"],"approvalLevel":"approval_required","status":"active"},
    {"id":"qa","name":"QA Agent","role":"Verification","responsibilities":["run tests","validate acceptance criteria","regression test","document failures"],"inputs":["build","acceptance_criteria"],"outputs":["verification_report","test_evidence"],"allowedTools":["shell","test","repository"],"forbiddenActions":["fake_pass","suppress_failures"],"escalationConditions":["flaky or nondeterministic critical tests"],"approvalLevel":"autonomous","status":"active"},
    {"id":"release","name":"Release / DevOps Agent","role":"Safe delivery","responsibilities":["prepare release","verify environment","execute approved deployment","verify rollback"],"inputs":["verified_build","release_plan","approval"],"outputs":["deployment_record","release_report"],"allowedTools":["ci","deployment","monitoring"],"forbiddenActions":["deploy_without_required_approval","delete_backup"],"escalationConditions":["production anomaly","failed rollback"],"approvalLevel":"approval_required","status":"active"},
    {"id":"growth","name":"Growth Agent","role":"Customer acquisition and retention","responsibilities":["test channels","analyze funnel","improve messaging","identify growth experiments"],"inputs":["customer_data","market_data","experiments"],"outputs":["growth_plan","experiment_proposals"],"allowedTools":["analytics","content","research"],"forbiddenActions":["misrepresent product claims"],"escalationConditions":["regulated communication","brand-risk claim"],"approvalLevel":"autonomous","status":"active"},
    {"id":"meta","name":"Meta-OS Agent","role":"System improvement","responsibilities":["detect process failures","propose policy changes","measure agent performance","retire obsolete workflows"],"inputs":["metrics","incidents","lessons","policy_history"],"outputs":["improvement_proposal","policy_change_proposal"],"allowedTools":["analytics","repository","analysis"],"forbiddenActions":["self-authorize constitutional changes"],"escalationConditions":["constitutional change","new high-risk permission"],"approvalLevel":"human_only","status":"active"}
  ]
